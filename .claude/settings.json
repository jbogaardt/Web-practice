{
  "permissions": {
    "allow": [
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push -u origin main)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pull-main.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-to-main.sh"
          }
        ]
      }
    ]
  }
}
